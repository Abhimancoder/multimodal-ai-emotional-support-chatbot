# Server Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/emotional_support_db

# Fallback to local SQLite if MySQL is unavailable
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=storage/app.db

# Multimodal AI Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=storage/chromadb

# File Upload Limits (in bytes)
MAX_IMAGE_SIZE_BYTES=5242880     # 5 MB
MAX_AUDIO_SIZE_BYTES=10485760    # 10 MB
